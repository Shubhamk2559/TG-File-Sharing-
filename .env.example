API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC...
DB_CHANNEL=-1001234567890
ADMINS=11111111 22222222
SALT=7919
WORKER_URL=https://your-worker.workers.dev
API_SECRET=your_worker_secret
# optional
BACKUP_CHANNEL=
FORCE_SUB=
FORCE_SUB_LINK=
AUTO_DELETE=0
PROTECT_CONTENT=0
CF_ACCOUNT_ID=
CF_API_TOKEN=
# performance (defaults are fine for most cases)
WORKERS=100
SEND_RATE=25
CACHE_TTL=300
CACHE_MAX=5000
# scheduled posts (optional): private source channel -> target channel
SOURCE_CHANNEL=
TARGET_CHANNEL=
TIMEZONE=Asia/Kolkata
BUTTON_TEXT=▶️ Watch Now
POST_CAPTION=🔥 New Video Uploaded!\n\nWatch now 👇
# 0 = button opens WORKER_URL/code, 1 = opens t.me/bot?start=code
POST_LINK_BOT=0

# daily limit: max videos one user can receive per day (0 = unlimited). Resets at midnight in TIMEZONE
DAILY_LIMIT=20
QUOTA_SAVE_EVERY=600
# ads (Monetag Rewarded Interstitial inside a Telegram Mini App) - leave empty to disable
AD_ZONE=
# public https URL of THIS bot service, no trailing slash (Koyeb: https://yourapp-yourorg.koyeb.app)
WEBAPP_URL=
AD_GATE=1
# minimum seconds between "ad started" and "ad finished"
AD_MIN_WATCH=5
# 1 = admins receive files without watching ads (default 0, so you can test the ad flow)
ADMINS_SKIP_ADS=0

